# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y reemplaza las llaves antes de desplegar
# ==========================================
ENVIRONMENT=development

# 1. Base de Datos PostgreSQL
POSTGRES_USER=maicofi_usuario
POSTGRES_PASSWORD=REEMPLAZAR_POR_CLAVE_SEGURA
POSTGRES_DB=maicofi_tolima_bd
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://maicofi_usuario:REEMPLAZAR_POR_CLAVE_SEGURA@127.0.0.1:5432/maicofi_tolima_bd

# 2. Backend FastAPI y Seguridad JWT
PROJECT_NAME=Maicofi API - Café Especial del Tolima
PROJECT_VERSION=1.0.0
API_V1_PREFIX=/api/v1
BACKEND_PORT=8001

JWT_SECRET_KEY=REEMPLAZAR_CON_MINIMO_32_CARACTERES_ALEATORIOS_EN_PRODUCCION
JWT_ALGORITHM=HS256
JWT_ISSUER=maicofi-tolima-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AUTH_RATE_LIMIT_PER_MINUTE=10
WRITE_RATE_LIMIT_PER_MINUTE=30

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DEMO_FARMER_PHONE=+573104528910
DEMO_BUYER_PHONE=+573001112233
DEMO_USER_PASSWORD=REEMPLAZAR_CLAVE_DEMO

# 3. Pasarela de Pagos Wompi Colombia
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# 4. Mensajería WhatsApp (Twilio / Meta Cloud API) y Email Transaccional (Resend)
TWILIO_ACCOUNT_SID=AC_REEMPLAZAR
TWILIO_AUTH_TOKEN=REEMPLAZAR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_WHATSAPP_TOKEN=REEMPLAZAR_META_CLOUD_TOKEN
META_WHATSAPP_PHONE_ID=REEMPLAZAR_META_PHONE_ID

RESEND_API_KEY=re_REEMPLAZAR_RESEND_API_KEY
RESEND_FROM_EMAIL=pedidos@maicofi.co

# 5. CDN e Imágenes Cloudinary (Optimización WebP)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=maicofi-tolima
CLOUDINARY_API_KEY=REEMPLAZAR_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=REEMPLAZAR_CLOUDINARY_SECRET

# 6. Logística y Envíos Nacionales (Skydropx / Coordinadora)
SKYDROPX_API_KEY=REEMPLAZAR_SKYDROPX_API_KEY
SKYDROPX_API_URL=https://api-demo.skydropx.com/v1

# 7. Facturación Electrónica DIAN (Dataico / Alegra API)
INVOICING_API_KEY=REEMPLAZAR_INVOICING_API_KEY
INVOICING_ENDPOINT=https://api.dataico.com/direct/dataico_api/v2/invoices
COMPANY_NIT=901456789-3
DIAN_RESOLUTION_NUMBER=18760000001
DIAN_PREFIX=SETT
TEST_MODE_DIAN=true

# 8. Frontend Fresh + Deno
MAICOFI_API_URL=http://127.0.0.1:8001/api/v1
